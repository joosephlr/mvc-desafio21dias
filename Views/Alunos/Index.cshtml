@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Alunos</h1>
</div>

<div class="mb-3">
    <a href="/alunos/create" class="btn btn-primary">+ Criar Novo Aluno</a>
</div>

<table class="table">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">Nome</th>
      <th scope="col">Matricula</th>
      <th scope="col">Notas</th>
      <th scope="col">Situação</th>
    </tr>
  </thead>
  <tbody>
    @foreach (var aluno in Model)
    {
        <tr>
        <th scope="row">@aluno.Id</th>
        <td>@aluno.Nome</td>
        <td>@aluno.Matricula</td>
        <td>@aluno.StrNotas()</td>
        @if (aluno.Situacao() == "Aprovado")
        {
          <td style="color: green; font-weight: bold;">Aprovado</td>
        }
        else
        {
          <td style="color: red; font-weight: bold;">Reprovado</td>

        }
        </tr>
    }
  </tbody>
</table>
